# Ignore configuration files that may contain sensitive data
/sites/*/settings.php
/sites/*/settings*.php

# Ignore file system
/sites/*/files
/sites/*/private

# Ignore Composer dependencies
/vendor/

# Ignore Drupal core (if using Composer to manage)
core/

# Ignore environment-specific files
.env
.env.local
.phpunit.result.cache

# Ignore temporary files
/tmp
*.log
*.cache
*.gz
*.zip
*.tar
*.tar.gz
*.tar.bz2

# Ignore IDE and editor folders/files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore node_modules if using frontend tools
/node_modules/
npm-debug.log
yarn-error.log

# Ignore test coverage and reports
/coverage
/junit.xml
/phpunit.xml

# Ignore backup and patch files
*.bak
*.patch
*.orig
*.rej

# Ignore Drush backups and logs
/drush/backups/
/drush/sites/
/drush/logs/

# Ignore simpletest files (if used)
/sites/simpletest

# Ignore scaffolding files (generated by drupal/recommended-project)
sites/*/files
sites/*/settings*.php
sites/simpletest
core
modules/contrib/
themes/contrib/
vendor/
/.csslintrc
/.eslintignore
/.eslintrc.json
/.ht.router.php
/.htaccess
/INSTALL.txt
/autoload.php
/example.gitignore
/index.php
/robots.txt
/update.php
/web.config