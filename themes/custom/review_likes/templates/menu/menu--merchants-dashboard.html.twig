{% import _self as menus %}

<nav>
  <ul class="navbar-nav">
    {{ menus.menu_links(items, attributes, 0) }}
  </ul>
</nav>

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}

  {% if items %}
    {% for item in items %}

      {# ---------- LEVEL 0 ---------- #}
      {% if menu_level == 0 %}

        {% if item.below %}
          <li class="nav-groupdropdown">
            <div
              class="nav-group-title"
              {# href="{{ item.url }}" #}
              data-bs-toggle="dropdown"
              role="button"
              aria-expanded="false">
              {{ item.title }}
            </div>

            <ul class=" nav-btn sub dropdown-menu">
              {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
            </ul>
          </li>

        {% else %}
          <li class="nav-btn">
            <a class="nav-btn" href="{{ item.url }}">
              {{ item.title }}
            </a>
          </li>
        {% endif %}

      {# ---------- LEVEL 1 ---------- #}
      {% elseif menu_level == 1 %}
        <li>
          <a class="dropdown-item" href="{{ item.url }}">
            {{ item.title }}
          </a>
        </li>
      {% endif %}

    {% endfor %}
  {% endif %}
{% endmacro %}


