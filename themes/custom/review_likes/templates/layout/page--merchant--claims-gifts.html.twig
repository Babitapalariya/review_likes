


<header class="">{{ page.header }}</header>

{% if 'merchant' in user.roles %}
	<div class="app" data-app="review-likes-dashboard">
		<!-- Sidebar -->
		{{ page.sidebar }}
		<!-- Main Content -->
		<main>
			<section
				id="contentArea">
				<!-- Add Product Form -->
				<div class="view" id="claims-gifts" style="display:block;">
					<section class="container col-md-11 mt-5 claims-gifts">
						{{ page.content }}

						{% if is_claims_gifts_page %}

							{# Combine and sort by created/changed date #}
							{% set all_items = [] %}

							{# Add claims with type indicator #}
							{% for claim in claims %}
								{% set all_items = all_items|merge([{
                                'type': 'rebuttal',
                                'id': claim.id,
                                'title': claim.title,
                                'description': claim.description,
                                'buyer_user': claim.buyer_user,
                                'email': claim.email,
                                'order_id': claim.order_id,
                                'product_link': claim.product_link,
                                'phone': claim.phone,
                                'commerce_platform': claim.commerce_platform,
                                'image': claim.image,
                                'date': claim.date,
                                'created': claim.created_timestamp|default(0),
                                'changed': claim.changed_timestamp|default(0),
                                'sort_date': claim.changed_timestamp|default(claim.created_timestamp|default(0))
                                }]) %}
							{% endfor %}

							{# Add gifts with type indicator #}
							{% for gift in gifts %}
								{% set all_items = all_items|merge([{
                                'type': 'gift',
                                'id': gift.id,
                                'title': gift.title,
                                'description': gift.description,
                                'buyer_user': gift.buyer_user,
                                'email': gift.email,
                                'order_id': gift.order_id,
                                'product_link': gift.product_link,
                                'phone': gift.phone,
                                'commerce_platform': gift.commerce_platform,
                                'image': gift.image,
                                'date': gift.date,
                                'created': gift.created_timestamp|default(0),
                                'changed': gift.changed_timestamp|default(0),
                                'sort_date': gift.changed_timestamp|default(gift.created_timestamp|default(0))
                                     }]) %}
							{% endfor %}

							{# Sort by changed date first, then created date (newest first) #}
							{% set all_items = all_items|sort((a, b) => b.sort_date <=> a.sort_date) %}

							{% if all_items %}
								<div class="table-responsive mt-5 col-md-12">
									<p>
										<strong>Note:</strong>
										We can add upto 10 rebuttal and submit together related to one product only.</p>
									<div class="col-md-12">
										<table class="table table-bordered table-hover align-middle">
											<thead class="table-primary text-center">
												<tr>
													<th><input type="checkbox" id="selectAll"></th>
													<th>Type</th>
													<th>Screenshot</th>
													<th>E-commerce Platform</th>
													<th>Product Link</th>
													<th>Buyer Username</th>
													<th>Email</th>
													<th>Order ID</th>
													<th>Phone</th>
													<th>Date & Time of Order</th>
													<th>Actions</th>
												</tr>
											</thead>
											<tbody>
												{% for item in all_items %}
													<tr>
														<td>
															<input type="checkbox" class="rowCheck" data-id="{{ item.id }}">
														</td>
														<td>
															<span class="badge {% if item.type == 'rebuttal' %}bg-warning{% else %}bg-success{% endif %}">
																{{ item.type|title }}
															</span>
														</td>
														<td>
															{% if item.image and item.image.url %}
																<img src="{{ item.image.url }}" alt="{{ item.image.alt }}" style="max-width: 50px; max-height: 50px;" class="img-thumbnail">
															{% else %}
																<span class="text-muted">No image</span>
															{% endif %}
														</td>
														<td>
															{{ item.commerce_platform|default('N/A') }}
														</td>
														<td>
															{% if item.product_link %}
																<a href="{{ item.product_link }}" target="_blank" class="text-decoration-none">
																	{{ item.product_link|length > 30 ? item.product_link|slice(0, 30) ~ '...' : item.product_link }}
																</a>
															{% else %}
																<span class="text-muted">N/A</span>
															{% endif %}
														</td>
														<td>
															{{ item.buyer_user|default('N/A') }}
														</td>
														<td>
															{% if item.email %}
																<a href="mailto:{{ item.email }}" class="text-decoration-none">
																	{{ item.email }}
																</a>
															{% else %}
																<span class="text-muted">N/A</span>
															{% endif %}
														</td>
														<td>
															{{ item.order_id|default('N/A') }}
														</td>
														<td>
															{% if item.phone %}
																<a href="tel:{{ item.phone }}" class="text-decoration-none">
																	{{ item.phone }}
																</a>
															{% else %}
																<span class="text-muted">N/A</span>
															{% endif %}
														</td>
														<td>
															{% if item.date %}
																{{ item.date|date('Y-m-d H:i') }}
															{% else %}
																<span class="text-muted">N/A</span>
															{% endif %}
														</td>
														<td class="action">
															<a href="{{ path('merchant_dashboard.rebuttal_edit', { 'nid': item.id }) }}" class="btn btn-sm btn-outline-primary me-2">
																<i class="bi bi-pencil"></i>
																Edit
															</a>
															<a href="{{ path('merchant_dashboard.delete_node', { 'node': item.id }) }}" class=" delete-claim-gift btn btn-sm btn-outline-danger" data-nid="{{ item.id }}">
																<i class="bi bi-trash"></i>
																Delete
															</a>
														</td>
													</tr>
												{% endfor %}
											</tbody>
										</table>
									</div>
								</div>

							{% else %}
								<div class="alert alert-info mt-5">
									<p>No claims or gifts available at the moment.</p>
								</div>
							{% endif %}
						{% endif %}
					</section>
				</div>
			</section>
		</main>
	</div>


{% else %}
	<p>You don’t have permission to see this data.</p>
{% endif %}

<div class="modal fade" id="deletegiftModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				Are you sure you want to delete this product?
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
			</div>
		</div>
	</div>
</div>
