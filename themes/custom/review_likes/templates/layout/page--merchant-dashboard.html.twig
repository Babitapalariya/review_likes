<header class="">{{ page.header }}</header>

{% if 'merchant' or 'administrator' in user.roles %}
<div class="app" data-app="review-likes-dashboard">
  <!-- Sidebar -->
  {{ page.sidebar }}
  <!-- Main Content -->
  <main>
    <section id="contentArea">
      <!-- Add Product Form -->
      <div class="view" id="add-products" style="display:block;">{{ page.content }}</div>
    </section>
  </main>
</div>
{% else %}
  <p>You don’t have permission to see this data.</p>
{% endif %}

