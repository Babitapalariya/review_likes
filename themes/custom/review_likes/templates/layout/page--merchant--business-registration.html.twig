<!-- Include Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
// If you still need custom JavaScript for additional functionality
document.addEventListener('DOMContentLoaded', function() {
    // Bootstrap handles the tab functionality automatically
    // You can add custom JavaScript here if needed
    
    // Example: Custom tab change event listener
    const tabEls = document.querySelectorAll('button[data-bs-toggle="tab"]');
    tabEls.forEach(tabEl => {
        tabEl.addEventListener('shown.bs.tab', function (event) {
            // This fires when a tab is shown
            console.log('Tab changed:', event.target.getAttribute('data-bs-target'));
        });
    });
});
</script>