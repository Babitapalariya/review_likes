<header class="">{{ page.header }}</header>

{% if 'merchant' in user.roles %}
  <div class="app" data-app="review-likes-dashboard">
    <!-- Sidebar -->
    {{ page.sidebar }}
    <!-- Main Content -->
    <main>
      <section id="contentArea">
        <!-- Add Product Form -->
        <div class="view" id="add-products" style="display:block;">
          <div class="container">
            <div class="row g-3">
              {{ page.content }}
              {% if is_claims_gifts_page %}
    {# Combine and sort by created/changed date #}
    {% set all_items = [] %}

    {# Add claims with type indicator #}
    {% for discount in claims %}
        {% set all_items = all_items|merge([{ 
            type: 'discount', 
            id: discount.id, 
            title: discount.title, 
            amount_saved: discount.amount_saved, 
            before: discount.before, 
            coupon_code: discount.coupon_code, 
            multi_use: discount.multi_use, 
            filter: discount.filter, 
            now: discount.now, 
            created: discount.created_timestamp|default(0), 
            changed: discount.changed_timestamp|default(0), 
            sort_date: discount.changed_timestamp|default(discount.created_timestamp|default(0)) 
        }]) %}
    {% endfor %}

    {% if all_items %}
        <div class="table-responsive mt-5 col-md-12 creatediscountTbl text-center">
            <div class="col-md-12">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-primary text-center">
                        <tr>
                            <th><input type="checkbox" id="selectAll"></th>
                            <th>Discount Type</th>
                            <th>Product Link</th>
                            <th>Coupon Code</th>
                            <th>Amount Before</th>
                            <th>Amount Now</th>
                            <th>Amount Saved</th>
                            <th>Status</th>
                            <th>Multi Use</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in all_items %}
                            <tr>
                                <td><input type="checkbox" class="rowCheck" data-id="{{ item.id }}"></td>
                               <td>{{ item.filter|default('0') }}</td>
                                   
                                <td>
                                    {# You'll need to add product_link to your PHP data #}
                                    <a href="{{ item.title|default('#') }}" class="text-decoration-none">
                                        {{item.title}}
                                    </a>
                                </td>
                                <td>{{ item.coupon_code|default('NA') }}</td>
                                <td>{{ item.before|default('0') }}</td>
                                <td>{{ item.now|default('0') }}</td>
                                <td>{{ item.amount_saved|default('0') }}</td>
                                <td>
                                    {# Determine status based on created/changed date or add status field #}
                                    {% set is_expired = item.created < date().timestamp - 2592000 %} {# 30 days ago #}
                                    <span class="badge {% if is_expired %}bg-warning{% else %}bg-success{% endif %}">
                                        {% if is_expired %}Expired{% else %}Active{% endif %}
                                    </span>
                                </td>
                                <td>{{ item.multi_use|default('No') }}</td>
                                <td class="action">
                                    <a href="{{ path('merchant_dashboard.discount_edit', { 'node': item.id }) }}" class="btn btn-sm btn-outline-primary me-2">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="{{ path('merchant_dashboard.delete_discount', { 'node': item.id }) }}" class=" delete-claim-gift btn btn-sm btn-outline-danger" data-nid="{{ item.id }}">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info mt-5">
            <p>No Discount available at the moment.</p>
        </div>
    {% endif %}
{% endif %}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
{% else %}
  <p>You don’t have permission to see this data.</p>
{% endif %}
<div class="modal fade" id="deletegiftModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				Are you sure you want to delete this product?
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
			</div>
		</div>
	</div>
</div>