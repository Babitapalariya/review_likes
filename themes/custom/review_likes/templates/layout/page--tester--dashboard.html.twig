<header class="">{{ page.header }}</header>

{% if 'tester' in user.roles %}
	<div
		class="app testerdashboard" data-app="review-likes-dashboard">
		<!-- Sidebar -->
		{{ page.sidebar }}
		<main>

			<section id="contentArea">
				<!-- Add Product Form -->
				<div class="view" id="add-products" style="display:block;">
                <div class="container my-5">
					{{ page.content }}
                    <h5 class="my-3 text-center">Profile Details</h5>
					{% if is_claims_gifts_page %}
						{# Combine and sort by created/changed date #}
						{% set all_items = [] %}

						{# Add claims with type indicator #}
						{% for tester in claims %}
							{% set all_items = all_items|merge([{ 
                                        type: 'tester_profile', 
                                        id: tester.id, 
                                        title: tester.title, 
                                        body: tester.body,
                                        Country: tester.Country, 
                                        before: tester.before, 
                                        coupon_code: tester.coupon_code, 
                                        multi_use: tester.multi_use, 
                                        filter: tester.filter, 
                                        now: tester.now, 
                                        created: tester.created_timestamp|default(0), 
                                        changed: tester.changed_timestamp|default(0), 
                                        sort_date: tester.changed_timestamp|default(tester.created_timestamp|default(0)) 
                                    }]) %}
						{% endfor %}

						{% if all_items %}
							

							<div class="table-responsive col-md-10 m-auto">
								<table class="table table-bordered text-center">
									<thead class="table-light">
										<tr>
											<th>Full Name</th>
											<th>Profile Picture</th>
											<th>Bio</th>
											<th>Country</th>
											<th>Portfolio Link</th>
											<th>YouTube Channel</th>
											<th>ID Verification
											</th>
											<th>Provided Previous Jobs</th>
											<th>Instagram Account</th>
											<th>Facebook Account</th>
											<th>X Account</th>
											<th>Blog URL</th>
											<th>Work Type</th>
											<th>Skills</th>
											<th>Languages Known</th>
											<th>Actions</th>
										</tr>
									</thead>
									<tbody>
										{% for tester in claims %}
											<tr>
												<td>{{ tester.title }}</td>

												<td>
													{% if tester.profile_Picture %}
														<img src="{{ tester.profile_Picture.url }}" alt="{{ tester.profile_Picture.alt }}" class="img-thumbnail mb-2" style="max-width: 50px;">
													{% else %}
														<span>No Image</span>
													{% endif %}
												</td>

												<td>{{ tester.body }}</td>
												<td>{{ tester.Country }}</td>

												<td>
													{% if tester.portfolio_link %}
														<a href="{{ tester.portfolio_link }}" target="_blank">Open</a>
													{% else %}
														NA
													{% endif %}
												</td>

												<td>{{ tester.youtube_link }}</td>
												<td>{% if tester.image %}
														<img src="{{ tester.image.url }}" alt="{{ tester.image.alt }}" class="img-thumbnail mb-2" style="max-width: 50px;">
													{% else %}
														<span>No Image</span>
													{% endif %}</td>
												<td>{{ tester.previous_jobs }}</td>

												<td>{{ tester.instagram_account }}</td>
												<td>{{ tester.facebook_account }}</td>
												<td>{{ tester.x_account }}</td>

												<td>{{ tester.blog_url }}</td>

												<td>{{ tester.work }}</td>
												<td>{{ tester.skills }}</td>

												<td>
													{% if tester.language %}
														{{ tester.language }}
													{% else %}
														NA
													{% endif %}
												</td>

												<td class="action">
																<a href="{{ path('tester_dashboard.tester_edit_form', { 'nid': tester.id }) }}" class="btn btn-sm btn-outline-primary me-2">
																	<i class="bi bi-pencil"></i>
																	Edit
																</a>
																<a href="{{ path('tester_dashboard.delete_node', { 'node': tester.id }) }}" class=" delete-tester btn btn-sm btn-outline-danger" data-nid="{{ tester.id }}">
																	<i class="bi bi-trash"></i>
																	Delete
																</a>
															</td>
											</tr>
										{% endfor %}
									</tbody>

								</table>
							</div>
						{% else %}
							<div class="alert alert-info mt-5">
								<p>No tester available at the moment.</p>
							</div>
						{% endif %}
					{% endif %}
				</div>
                </div>
			</section>
		</main>
	</div>
{% else %}
	<p>You don’t have permission to see this data.</p>
{% endif %}


<div class="modal fade" id="deletegiftModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				Are you sure you want to delete this product?
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
			</div>
		</div>
	</div>
</div>
