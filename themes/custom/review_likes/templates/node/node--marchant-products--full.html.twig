{# ── Debate Login Modal ──────────────────────────────────────────────────── #}
<div class="modal fade" id="debateLoginModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
    <div class="modal-content" style="border-radius:18px;overflow:hidden;">

      <div class="modal-header" style="border-bottom:1px solid #e8e8e4;padding:20px 24px;">
        <div>
          <h5 class="modal-title" style="font-weight:700;margin-bottom:2px;">Login to Participate</h5>
          <div style="font-size:12px;color:#6b6b63;">Join the debate and post your statement</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body" style="padding:24px;">

        {# Standard Drupal login form — redirects back here after login #}
        {{ drupal_form('Drupal\\user\\Form\\UserLoginForm') }}

        <div class="debate-login-links" style="text-align:center;margin-top:16px;padding-top:16px;border-top:1px solid #e8e8e4;display:flex;flex-direction:column;gap:8px;">
          <div>
            <span style="font-size:13px;color:#6b6b63;">Don't have an account?</span>
            <a href="/user/register" style="font-size:13px;font-weight:600;color:#1a1a17;margin-left:6px;text-decoration:none;">Register here</a>
          </div>
          <a href="/user/password" style="font-size:12px;color:#8a8a82;text-decoration:none;">Forgot your password?</a>
        </div>

      </div>
    </div>
  </div>
</div>
