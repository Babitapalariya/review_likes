{#
/**
 * @file
 * Theme override for a comment form.
 *
 * Variables:
 * - attributes: HTML attributes for the <form> tag.
 * - children: All form fields and buttons.
 * - form_id: The actual ID of the form (must be passed from preprocess).
 */
#}

{% set form_id = element['#id'] ?? '' %}

{% if form_id == 'views-exposed-form-product-block-1' %}
  <form{{ attributes.addClass('w-100') }}>
    {{ children }}
  </form>

{% elseif form_id == 'views-exposed-form-all-products-block-1' %}
  <form{{ attributes.addClass('input-group') }}>
    {{ children }}
  </form>

{% else %}
  <form{{ attributes }}>
    {{ children }}
  </form>
{% endif %}
