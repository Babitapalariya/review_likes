function review_likes_preprocess_node(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
   $current_path = \Drupal::request()->getRequestUri();
  if ($node) {
     $current_path = \Drupal::request()->getRequestUri();
     
    if ($node->id() == 1) {
      $variables['#attached']['library'][] = 'review_likes/home-css';
    }
  }


$rebuttal_node = $variables['node'];
 if ($rebuttal_node->bundle() === 'marchant_products' && $variables['view_mode'] === 'full') {
    // The hook_node_view stored rebuttals in the build array.
    // Pass them to the Twig template as a clean variable.
    $variables['_rebuttals'] = $variables['elements']['#rebuttals'] ?? [];
    $variables['_product_id'] = $node->id();
    $variables['_debate_forms']   = $variables['elements']['#debate_forms']   ?? [];
    $variables['_claim_forms']    = $variables['elements']['#claim_forms']    ?? [];  // ← ADD
    $variables['_user_logged_in'] = $variables['elements']['#user_logged_in'] ?? FALSE;
    $variables['_claimed_rebuttals'] = $variables['elements']['#claimed_rebuttals'] ?? [];
    $variables['_claims_data'] = $variables['elements']['#claims_data'] ?? [];
  }



}



function review_likes_preprocess_field(&$variables) {
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
}



function review_likes_preprocess_views_view_fields(&$variables) {
  $current_path = \Drupal::service('path.current')->getPath();
  $variables['current_path'] = $current_path;
  
  // Add front page check
  $variables['is_front_page'] = \Drupal::service('path.matcher')->isFrontPage();
}




 /**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 * When rendered inside the debate modal, redirect back to current page.
 */
function review_likes_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Get current path and set as redirect destination.
  /*$current_path = \Drupal::service('path.current')->getPath();
  $form['#action'] = \Drupal\Core\Url::fromRoute('user.login', [], [
    'query' => ['destination' => $current_path],
  ])->toString();*/
  $current_path = \Drupal::service('path.current')->getPath();
  $destination  = \Drupal::request()->query->get('destination', $current_path);

  // Override form action to include destination.
  $form['#action'] = \Drupal\Core\Url::fromRoute('user.login', [], [
    'query' => ['destination' => $destination],
  ])->toString();
}



 