function review_likes_preprocess_page(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  
  if ($route_name == 'merchant_dashboard.claims_gifts') {
    $variables['is_claims_gifts_page'] = TRUE;
    
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    
    // Load gift content type nodes
    $gift_query = $node_storage->getQuery()
      ->condition('type', 'gift')
      ->condition('status', 1)
      ->sort('created', 'DESC')
      ->accessCheck(TRUE);
    
    $gift_nids = $gift_query->execute();
    
    if ($gift_nids) {
      $gift_nodes = $node_storage->loadMultiple($gift_nids);
      $variables['gifts'] = [];
      
      foreach ($gift_nodes as $gift) {
        $variables['gifts'][] = [
          'id' => $gift->id(),
          'title' => $gift->getTitle(),
          'description' => $gift->hasField('body') && !$gift->body->isEmpty() 
            ? $gift->body->value 
            : '',
          'buyer_user' => $gift->hasField('field_buyer_username') && !$gift->field_buyer_username->isEmpty() 
            ? $gift->field_buyer_username->value 
            : NULL,
          'email' => $gift->hasField('field_email') && !$gift->field_email->isEmpty() 
            ? $gift->field_email->value 
            : NULL,
          'order_id' => $gift->hasField('field_external_id') && !$gift->field_external_id->isEmpty() 
            ? $gift->field_external_id->value 
            : NULL,
          'product_link' => $gift->hasField('field_product_url') && !$gift->field_product_url->isEmpty() 
            ? $gift->field_product_url->value 
            : NULL,
          'phone' => $gift->hasField('field_telephone') && !$gift->field_telephone->isEmpty() 
            ? $gift->field_telephone->value 
            : NULL,
         'commerce_platform' => $gift->hasField('field_e_commerce_platform') && !$gift->get('field_e_commerce_platform')->isEmpty()
            ? $gift->get('field_e_commerce_platform')->entity->label()
            : NULL,

                    'image' => $gift->hasField('field_image') && !$gift->field_image->isEmpty() 
            ? [
                'url' => \Drupal::service('file_url_generator')->generateAbsoluteString($gift->field_image->entity->getFileUri()),
                'alt' => $gift->field_image->alt,
              ] 
            : NULL,

          'date' => $gift->hasField('field_order_datetime') && !$gift->field_order_datetime->isEmpty() 
            ? $gift->field_order_datetime->value 
            : NULL,
          'created_timestamp' => $gift->getCreatedTime(),
          'changed_timestamp' => $gift->getChangedTime(),
        ];
      }
    }
    
    // Load rebuttal content type nodes
    $claim_query = $node_storage->getQuery()
      ->condition('type', 'rebuttal')
      ->condition('status', 1)
      ->sort('created', 'DESC')
      ->accessCheck(TRUE);
    
    $claim_nids = $claim_query->execute();
    
    if ($claim_nids) {
      $claim_nodes = $node_storage->loadMultiple($claim_nids);
      $variables['claims'] = [];
      
      foreach ($claim_nodes as $claim) {
        $variables['claims'][] = [
          'id' => $claim->id(),
          'title' => $claim->getTitle(),
          'description' => $claim->hasField('body') && !$claim->body->isEmpty() 
            ? $claim->body->value 
            : '',
          'buyer_user' => $claim->hasField('field_buyer_username') && !$claim->field_buyer_username->isEmpty() 
            ? $claim->field_buyer_username->value 
            : NULL,
          'email' => $claim->hasField('field_email') && !$claim->field_email->isEmpty() 
            ? $claim->field_email->value 
            : NULL,
          'order_id' => $claim->hasField('field_external_id') && !$claim->field_external_id->isEmpty() 
            ? $claim->field_external_id->value 
            : NULL,
          'product_link' => $claim->hasField('field_product_url') && !$claim->field_product_url->isEmpty() 
            ? $claim->field_product_url->value 
            : NULL,
          'phone' => $claim->hasField('field_telephone') && !$claim->field_telephone->isEmpty() 
            ? $claim->field_telephone->value 
            : NULL,
             'commerce_platform' => $claim->hasField('field_e_commerce_platform') && !$claim->get('field_e_commerce_platform')->isEmpty()
            ? $claim->get('field_e_commerce_platform')->entity->label()
            : NULL,
                    'image' => $claim->hasField('field_image') && !$claim->field_image->isEmpty() 
            ? [
                'url' => \Drupal::service('file_url_generator')->generateAbsoluteString($claim->field_image->entity->getFileUri()),
                'alt' => $claim->field_image->alt,
              ] 
            : NULL,

          'date' => $claim->hasField('field_order_datetime') && !$claim->field_order_datetime->isEmpty() 
            ? $claim->field_order_datetime->value 
            : NULL,
          'created_timestamp' => $claim->getCreatedTime(),
          'changed_timestamp' => $claim->getChangedTime(),
        ];
      }
    }

  }

if ($route_name == 'merchant_dashboard.discount_form') {
    $variables['is_claims_gifts_page'] = TRUE;
    
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    
    // Load Discount content type nodes
    $discount_query = $node_storage->getQuery()
      ->condition('type', 'discount')
      ->condition('status', 1)
      ->sort('created', 'DESC')
      ->accessCheck(TRUE);
    
    $discount_nids = $discount_query->execute();
    
    if ($discount_nids) {
      $discount_nodes = $node_storage->loadMultiple($discount_nids);
      $variables['claims'] = [];
      
      foreach ($discount_nodes as $discount) {
        $variables['claims'][] = [
          'id' => $discount->id(),
          'title' => $discount->getTitle(),
          'amount_saved' => $discount->hasField('field_legal_business_name') && !$discount->field_legal_business_name->isEmpty() 
            ? $discount->field_legal_business_name->value 
            : '',
          'before' => $discount->hasField('field_buyer_username') && !$discount->field_buyer_username->isEmpty() 
            ? $discount->field_buyer_username->value 
            : '0',
          'coupon_code' => $discount->hasField('field_external_id') && !$discount->field_external_id->isEmpty() 
            ? $discount->field_external_id->value 
            : 'NA',
          'multi_use' => $discount->hasField('field_terms_and_conditions') && !$discount->field_terms_and_conditions->isEmpty() 
            ? 'Yes' 
            : 'No',
          'now' => $discount->hasField('field_comment_text') && !$discount->field_comment_text->isEmpty() 
            ? $discount->field_comment_text->value 
            : '0',
          'filter' => $discount->hasField('field_filter') && !$discount->get('field_filter')->isEmpty()
            ? $discount->get('field_filter')->entity->label()
            : NULL,
          // Add product link field - you'll need to create this field or map to existing field
          'product_link' => $discount->hasField('field_product_link') && !$discount->field_product_link->isEmpty() 
            ? $discount->field_product_link->value 
            : '#',
          'created_timestamp' => $discount->getCreatedTime(),
          'changed_timestamp' => $discount->getChangedTime(),
        ];
      }
    } else {
      $variables['claims'] = [];
    }
}
if ($route_name == 'tester_dashboard.dashboard') {
    $variables['is_claims_gifts_page'] = TRUE;
    
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    
    // Load Discount content type nodes
    $tester_query = $node_storage->getQuery()
      ->condition('type', 'tester_profile')
      ->condition('status', 1)
      ->sort('created', 'DESC')
      ->accessCheck(TRUE);
    
    $tester_nids = $tester_query->execute();
    
    if ($tester_nids) {
      $tester_nodes = $node_storage->loadMultiple($tester_nids);
      $variables['claims'] = [];
      
      foreach ($tester_nodes as $tester) {
       $variables['claims'][] = [
  'id' => $tester->id(),
  'title' => $tester->getTitle(),
  'body' => $tester->body->value ?? '',

  'Country' => $tester->field_country->value ?? 'NA',

  'instagram_account' => $tester->field_testing_type_other->value ?? 'NA',
  'facebook_account' => $tester->field_sports_specification->value ?? 'NA',
  'x_account' => $tester->field_specific_regions->value ?? 'NA',

  'previous_jobs' => $tester->field_external_id->value ?? 'NA',
  'skills' => $tester->field_licenses_other->value ?? 'NA',
 'language'=> $tester->field_language->value ?? 'NA',
 'language' => $tester->hasField('field_language') && !$tester->get('field_language')->isEmpty()
            ? $tester->get('field_language')->entity->label()
            : NULL,
 'work' => $tester->hasField('field_filter') && !$tester->get('field_filter')->isEmpty()
            ? $tester->get('field_filter')->entity->label()
            : NULL,
  'blog_url' => $tester->field_blog_url->uri ?? '#',
  'youtube_link' => $tester->field_youtube_channel->uri ?? '#',

'profile_Picture' => $tester->field_image->isEmpty()
      ? NULL
      : [
          'url' => \Drupal::service('file_url_generator')->generateAbsoluteString($tester->field_image->entity->getFileUri()),
          'alt' => $tester->field_image->alt,
        ],
         'image' => $tester->hasField('field_id_verification_image') && !$tester->field_id_verification_image->isEmpty() 
            ? [
                'url' => \Drupal::service('file_url_generator')->generateAbsoluteString($tester->field_id_verification_image->entity->getFileUri()),
                'alt' => $tester->field_id_verification_image->alt,
              ] 
            : NULL,

  'portfolio_link' => $tester->field_store_link->uri ?? '#',

  'created_timestamp' => $tester->getCreatedTime(),
  'changed_timestamp' => $tester->getChangedTime(),
];

      }
    } else {
      $variables['claims'] = [];
    }
}












$current_path = \Drupal::request()->getRequestUri();

