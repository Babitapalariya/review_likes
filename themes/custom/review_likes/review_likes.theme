function review_likes_preprocess_views_exposed_form(&$variables) {
  if (isset($variables['form']['field_filter_target_id'])) {
    $variables['form']['field_filter_target_id']['#attributes']['class'][] = 'sort-dropdown';
    
  }

   }


/**
 * Implements hook_form_alter().
 */
function review_likes_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Check if the field exists in the form
  
  if (isset($form['field_products_target_id'])) {
    // Get raw submitted value (still a string like "5,2")
    $raw_input = $form_state->getUserInput();
    if (!empty($raw_input['field_products_target_id'])) {
      // Convert "5,2" to ['5', '2']
     
     if (
  isset($raw_input['field_products_target_id']) &&
  is_array($raw_input['field_products_target_id']) &&
  isset($raw_input['field_products_target_id'][0]) &&
  is_string($raw_input['field_products_target_id'][0])
) {
  $exploded = explode(',', $raw_input['field_products_target_id'][0]);

  // Update both user input and form values
  $form_state->setValue('field_products_target_id', $exploded);
  $raw_input['field_products_target_id'] = $exploded;
  $form_state->setUserInput($raw_input);
}

 
      // Update both user input and form values
      // $form_state->setValue('field_products_target_id', $exploded);
      $input = $form_state->getUserInput();
      // $input['field_products_target_id'] = $exploded;
      $form_state->setUserInput($input);
    }
  }
  // Get the raw user input
  $route_name = \Drupal::routeMatch()->getRouteName();
  \Drupal::logger('review_likes')->notice('Hook fired for form ID: @id', ['@id' => $form_id]);

  // Clean empty field_products_target_id[] values
  if (isset($form['field_products_target_id'])) {
    $input = $form_state->getUserInput();

    // If it's an array and contains an empty string, remove it
    if (!empty($input['field_products_target_id']) && is_array($input['field_products_target_id'])) {
      $cleaned = array_filter($input['field_products_target_id'], function ($value) {
        return $value !== '';
      });

      $form_state->setValue('field_products_target_id', $cleaned);
      $input['field_products_target_id'] = $cleaned;
      $form_state->setUserInput($input);

      \Drupal::logger('review_likes')->notice('Cleaned product filter: <pre>@data</pre>', ['@data' => print_r($cleaned, TRUE)]);
    }
  }

}


