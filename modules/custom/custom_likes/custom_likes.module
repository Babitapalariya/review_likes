function custom_likes_preprocess_page(array &$variables) {
$request = \Drupal::service('request_stack')->getCurrentRequest();
$current_uri = $request->getRequestUri(); // This includes the alias like /products/some-product
  $login_url = Url::fromRoute('user.login', [], [
  'query' => ['destination' => $current_uri],
])->toString();


  $variables['#attached']['drupalSettings']['customLikes'] = [
    'isUserLoggedIn' => \Drupal::currentUser()->isAuthenticated(),
    'loginUrl' => $login_url,
  ];
}
