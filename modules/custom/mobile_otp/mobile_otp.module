// In mobile_otp.module file
function mobile_otp_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id == 'profile-completion-form') { // Replace with your actual form ID
    $form['#attached']['library'][] = 'mobile_otp/otp-verification';
  }
}


/**
 * Implements hook_user_login().
 */
function mobile_otp_user_login(UserInterface $account) {
  // Only redirect if profile completion is required.
  if ($account->hasRole('merchant') || $account->hasRole('game_changer')|| $account->hasRole('tester')) {
    $current_request = \Drupal::service('request_stack')->getCurrentRequest();

    // Avoid overriding if a destination is already set.
    if (!$current_request->query->get('destination')) {
      // Build the URL to your route.
      $url = Url::fromRoute('role_based_registration.profile_completion', [
        'user' => $account->id(),
      ], ['absolute' => TRUE])->toString();

      // Set it as the destination.
      $current_request->query->set('destination', $url);
    }
  }
}
