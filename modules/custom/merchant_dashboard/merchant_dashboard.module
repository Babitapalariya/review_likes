  $fallbacks = [
    'field_gender_preference' => [
      'no_preference' => 'No Preference',
      'male' => 'Male',
      'female' => 'Female',
      'non_binary' => 'Non-binary',
      'other' => 'Other',
    ],
    'field_age_range' => [
      '18-24' => '18-24',
      '25-34' => '25-34',
      '35-44' => '35-44',
      '45-54' => '45-54',
      '55+' => '55+',
      'no_preference' => 'No Preference',
    ],
    'field_location_preferences' => [
      'indoor' => 'Indoor',
      'outdoor' => 'Outdoor',
      'both' => 'Both Indoor & Outdoor',
    ],
    'field_safety_gear_needed' => [
      'helmet' => 'Helmet',
      'gloves' => 'Gloves',
      'protective_clothing' => 'Protective Clothing',
      'other' => 'Other',
      'none' => 'No Safety Gear Required',
    ],
    'field_licenses_certifications' => [
      'drivers_license' => 'Driver\'s License',
      'commercial_license' => 'Commercial License (CDL)',
      'drone_pilot' => 'Drone Pilot',
      'other' => 'Other',
      'none' => 'No Licenses Required',
    ],
    'field_platform_preferences' => [
      'youtube' => 'YouTube',
      'tiktok' => 'TikTok',
      'instagram' => 'Instagram',
      'facebook' => 'Facebook',
      'other' => 'Other',
    ],
    'field_follower_count' => [
      'micro_influencer' => 'Micro-Influencer (1K-10K)',
      'mid_tier' => 'Mid-Tier (10K-100K)',
      'macro' => 'Macro (100K+)',
      'no_preference' => 'No Preference',
    ],
    'field_content_style' => [
      'professional_reviews' => 'Professional Reviews',
      'casual_ugc' => 'Casual/UGC',
      'cinematic' => 'Cinematic',
      'tutorials' => 'Tutorials',
      'other' => 'Other',
    ],
    'field_payment_structure' => [
      'per_video' => 'Per Video (Fixed rate) - 15 to 58 sec',
      'other_structure' => 'Other Payment Structure',
