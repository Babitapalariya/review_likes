/**
 * Implements hook_user_login().
 */
function role_based_registration_user_login($account) {
  $tempstore = \Drupal::service('tempstore.private')->get('role_based_registration');
  $uid = $account->id();
  
  if ($role = $tempstore->get('role_' . $uid)) {
    // Add role to user
    $account->addRole($role);
    $account->save();
    
    // Clear tempstore
    $tempstore->delete('role_' . $uid);
  }
}