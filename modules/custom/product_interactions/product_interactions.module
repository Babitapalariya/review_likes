/**
 * Debug validate handler for user form.
 * ⚠️ Was "mymodule_user_form_validate_debug" — now fixed to match above
 */
function product_interactions_user_form_validate_debug(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  \Drupal::logger('product_interactions')->debug('=== VALIDATE DEBUG ===');
  \Drupal::logger('product_interactions')->debug('Roles value: @roles', [
    '@roles' => print_r($form_state->getValue('roles'), TRUE),
  ]);
  \Drupal::logger('product_interactions')->debug('Form errors: @errors', [
    '@errors' => print_r($form_state->getErrors(), TRUE),
  ]);
  \Drupal::logger('product_interactions')->debug('All values: @values', [
    '@values' => print_r($form_state->getValues(), TRUE),
  ]);
}


function product_interactions_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {

  if (in_array($form_id, ['user_register_form', 'user_form'])) {

    // Log the form class responsible
    $form_object = $form_state->getFormObject();
    \Drupal::logger('product_interactions')->notice('Form class: @class', [
      '@class' => get_class($form_object),
    ]);

    $form['#validate'][] = 'product_interactions_user_form_validate_debug';
  }
}